  { kw: 'puff pastry', cat: 'Frozen' },
  { kw: 'avocardo', cat: 'Fruit & Veg' },
  { kw: 'snow pea', cat: 'Fruit & Veg' },
];

function renderShoppingList(){
  const card = document.getElementById('shopCard');
  const selectedMeals = state.meals.filter(m=>state.selected.includes(m.id));
  document.getElementById('statMeals').textContent = selectedMeals.length;

  if(selectedMeals.length === 0){
    card.innerHTML = '<div class="empty">No shopping list yet — pick some meals in "This Week" first.</div>';
    document.getElementById('statItems').textContent = 0;
    document.getElementById('statHave').textContent = 0;
    return;
  }

  const rawEntries = [];
  selectedMeals.forEach(meal=>{
    meal.ingredients.forEach(ing=>{
      rawEntries.push({ text: ing, mealName: meal.name });
    });
  });
  const merged = consolidateIngredients(rawEntries);
  const keys = Object.keys(merged);

  // group by category
  const groups = {};
  keys.forEach(key=>{
    const item = merged[key];
    const displayName = displayNameFor(item);
    const catSource = [...item.originals][0] || displayName;
    const cat = categorize(catSource);
    if(!groups[cat]) groups[cat] = [];
    groups[cat].push({ key, item, displayName });
  });

  let haveCount = 0;
  let html = '';
  CATEGORY_ORDER.forEach(cat=>{
    if(!groups[cat]) return;
    groups[cat].sort((a,b)=>a.displayName.localeCompare(b.displayName));
    html += `<div class="shopping-group"><h3>${escapeHtml(cat)}</h3>`;
    groups[cat].forEach(({key, item, displayName})=>{
      const checked = !!state.checkedOff[key];
      if(checked) haveCount++;
      const mealsList = [...item.meals].join(', ');
      html += `
        <div class="shop-item ${checked?'checked':''}" data-key="${escapeAttr(key)}">
          <input type="checkbox" ${checked?'checked':''}>
          <div class="label">${escapeHtml(displayName)}<span class="meals-for">${escapeHtml(mealsList)}</span></div>
        </div>
      `;
    });
    html += '</div>';
  });
  card.innerHTML = html;

  document.getElementById('statItems').textContent = keys.length - haveCount;
  document.getElementById('statHave').textContent = haveCount;

  card.querySelectorAll('.shop-item').forEach(el=>{
    el.addEventListener('click', (e)=>{
      const key = el.dataset.key;
      state.checkedOff[key] = !state.checkedOff[key];
      save();
      renderShoppingList();
    });
  });
}

document.getElementById('resetChecksBtn').addEventListener('click', ()=>{
  state.checkedOff = {};
  save();
  renderShoppingList();
  toast('Ticks cleared');
});

document.getElementById('genFinalBtn').addEventListener('click', ()=>{
  renderFinalList();
  switchToView('final');
});

document.getElementById('backToShopBtn').addEventListener('click', ()=>{
  switchToView('shop');
  renderShoppingList();
});

document.getElementById('printFinalBtn').addEventListener('click', ()=>{
  window.print();
});

document.getElementById('resetFinalTicksBtn').addEventListener('click', ()=>{
  state.finalTicked = {};
  save();
  renderFinalList();
  toast('Crossed-off items reset');
});

function renderFinalList(){
  const body = document.getElementById('finalListBody');
  const selectedMeals = state.meals.filter(m=>state.selected.includes(m.id));

  if(selectedMeals.length === 0){
    body.innerHTML = '<div class="empty">No meals planned yet.</div>';
    document.getElementById('finalCount').textContent = 0;
    return;
  }

  const rawEntries = [];
  selectedMeals.forEach(meal=>{
    meal.ingredients.forEach(ing=>{
      rawEntries.push({ text: ing, mealName: meal.name });
    });
  });
  const merged = consolidateIngredients(rawEntries);

  // only items NOT ticked off as "already have" back in the shopping list step
  const remainingKeys = Object.keys(merged).filter(key => !state.checkedOff[key]);

  if(remainingKeys.length === 0){
    body.innerHTML = '<div class="empty">You have everything you need already! 🎉</div>';
    document.getElementById('finalCount').textContent = 0;
    return;
  }

  const groups = {};
  remainingKeys.forEach(key=>{
    const item = merged[key];
    const displayName = displayNameFor(item);
    const catSource = [...item.originals][0] || displayName;
    const cat = categorize(catSource);
    if(!groups[cat]) groups[cat] = [];
    groups[cat].push({ key, item, displayName });
  });

  let stillToGet = 0;
  let html = '';
  CATEGORY_ORDER.forEach(cat=>{
    if(!groups[cat]) return;
    groups[cat].sort((a,b)=>a.displayName.localeCompare(b.displayName));
    html += `<div class="shopping-group"><h3>${escapeHtml(cat)}</h3>`;
    groups[cat].forEach(({key, item, displayName})=>{
      const ticked = !!state.finalTicked[key];
      if(!ticked) stillToGet++;
      const mealsList = [...item.meals].join(', ');
      html += `
        <div class="shop-item ${ticked?'checked':''}" data-key="${escapeAttr(key)}">
          <input type="checkbox" ${ticked?'checked':''}>
          <div class="label">${escapeHtml(displayName)}<span class="meals-for">${escapeHtml(mealsList)}</span></div>
        </div>
      `;
    });
    html += '</div>';
  });
  body.innerHTML = html;
  document.getElementById('finalCount').textContent = stillToGet;

  body.querySelectorAll('.shop-item').forEach(el=>{
    el.addEventListener('click', ()=>{
      const key = el.dataset.key;
      state.finalTicked[key] = !state.finalTicked[key];
      save();
      renderFinalList();
    });
  });
}

// ---------- MEALS VIEW ----------
let editingMealId = null;

function renderMealsList(){
  const list = document.getElementById('mealList');
  document.getElementById('mealTotalCount').textContent = state.meals.length;
  if(state.meals.length === 0){
    list.innerHTML = '<div class="empty">No meals yet — add your first one.</div>';
    return;
  }
  list.innerHTML = '';
  state.meals.forEach(meal=>{
    const div = document.createElement('div');
    div.className = 'meal-list-item';
    div.innerHTML = `
      <div class="details">
        <b>${escapeHtml(meal.name)}</b>
        <div class="ingredients">${escapeHtml(meal.ingredients.join(', '))}</div>
      </div>
      <button class="icon-btn" data-edit="${meal.id}">✏️</button>
    `;
    list.appendChild(div);
  });
  list.querySelectorAll('[data-edit]').forEach(btn=>{
    btn.addEventListener('click', ()=>openMealModal(btn.dataset.edit));
  });
}

function openMealModal(mealId){
  editingMealId = mealId || null;
  const modal = document.getElementById('mealModalBg');
  const title = document.getElementById('modalTitle');
  const nameInput = document.getElementById('mealNameInput');
  const ingInput = document.getElementById('mealIngInput');
  const delBtn = document.getElementById('deleteMealBtn');

  if(mealId){
    const meal = state.meals.find(m=>m.id === mealId);
    title.textContent = 'Edit meal';
    nameInput.value = meal.name;
    ingInput.value = meal.ingredients.join('\n');
    delBtn.style.display = 'block';
  } else {
    title.textContent = 'Add a meal';
    nameInput.value = '';
    ingInput.value = '';
    delBtn.style.display = 'none';
  }
  modal.classList.add('active');
  nameInput.focus();
}

function closeMealModal(){
  document.getElementById('mealModalBg').classList.remove('active');
  editingMealId = null;
}

document.getElementById('addMealBtn').addEventListener('click', ()=>openMealModal(null));
document.getElementById('cancelMealBtn').addEventListener('click', closeMealModal);
document.getElementById('mealModalBg').addEventListener('click', (e)=>{
  if(e.target.id === 'mealModalBg') closeMealModal();
});

document.getElementById('saveMealBtn').addEventListener('click', ()=>{
  const name = document.getElementById('mealNameInput').value.trim();
  const ingredients = document.getElementById('mealIngInput').value
    .split('\n').map(s=>s.trim()).filter(Boolean);

  if(!name){ toast('Give the meal a name'); return; }
  if(ingredients.length === 0){ toast('Add at least one ingredient'); return; }

  if(editingMealId){
    const meal = state.meals.find(m=>m.id === editingMealId);
    meal.name = name;
    meal.ingredients = ingredients;
    toast('Meal updated');
  } else {
    const id = 'm' + Date.now();
    state.meals.push({ id, name, ingredients });
    toast('Meal added');
  }
  save();
  closeMealModal();
  renderMealsList();
  renderPlanGrid();
});

document.getElementById('deleteMealBtn').addEventListener('click', ()=>{
  if(!editingMealId) return;
  if(!confirm('Delete this meal for good?')) return;
  state.meals = state.meals.filter(m=>m.id !== editingMealId);
  state.selected = state.selected.filter(id=>id !== editingMealId);
  save();
  closeMealModal();
  renderMealsList();
  renderPlanGrid();
  toast('Meal deleted');
});

// ---------- UTIL ----------
function escapeHtml(str){
  return String(str).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function escapeAttr(str){
  return String(str).replace(/"/g,'&quot;');
}

// ---------- INIT ----------
renderPlanGrid();
renderMealsList();
renderShoppingList();
</script>

